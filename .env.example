# Application Configuration
# Copy this file to .env.local and update with your actual values
# DO NOT commit .env.local to version control

# Weather API proxy base URL (must end with trailing slash)
EXPO_PUBLIC_WEATHER_API_URL=https://open-weather-proxy-pi.vercel.app/api/v1/

# Support email for users to contact when experiencing persistent issues
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Splash screen timeout in milliseconds
# After this time, the app will show UI regardless of loading state
EXPO_PUBLIC_SPLASH_TIMEOUT_MS=3000

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Leave empty to disable Sentry crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# Sentry Auth Token (build-time only, DO NOT commit)
# Used for uploading source maps during builds
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# IMPORTANT: Do NOT use EXPO_PUBLIC_ prefix - this token must never be exposed to
# clients, AND sentry-cli / sentry.gradle only read this exact name. A prefixed
# copy is silently ignored, so builds upload no source maps and every stack
# trace in Sentry arrives unsymbolicated.
SENTRY_AUTH_TOKEN=

# Force-enable Sentry event delivery in a dev build (default: off)
# Sentry is normally disabled when __DEV__ is true, so the wiring cannot be
# smoke-tested without cutting a release build. Set to exactly "true" to opt a
# dev build into sending; any dev events land in the "development" environment.
# Leave unset for normal development.
EXPO_PUBLIC_SENTRY_FORCE_ENABLE=
