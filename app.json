{
  "expo": {
    "name": "Dualtemp Weather",
    "slug": "dualtemp-weather",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1B4D"
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "supportsRTL": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to show you the weather.",
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ar", "en", "es", "fr", "he", "zh"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "ek-solutions"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeatherCompact",
              "label": "Weather (Compact)",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Essential weather info in 1x1 size",
              "previewImage": "./assets/widget-preview/Compact.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeatherStandard",
              "label": "Weather (Standard)",
              "minWidth": "40dp",
              "minHeight": "110dp",
              "targetCellWidth": 1,
              "targetCellHeight": 2,
              "description": "Current weather with mini forecast in 1x2 size",
              "previewImage": "./assets/widget-preview/Standard.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal"
            },
            {
              "name": "WeatherExtended",
              "label": "Weather (Extended)",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "description": "Daily forecast, resizable from 2x1 to 5x5",
              "previewImage": "./assets/widget-preview/Extended.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp"
            }
          ]
        }
      ],
      "./plugins/withWidgetBuildNumber",
      "@bacons/apple-targets"
    ],
    "ios": {
      "appleTeamId": "RUW8C26QSP",
      "supportsTablet": true,
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false,
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "bundleIdentifier": "com.ekarni.rndualtempweatherapp",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.ekarni.rndualtempweatherapp.widget"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1B4D"
      },
      "package": "com.ekarni.rndualtempweatherapp",
      "permissions": []
    },
    "updates": {
      "url": "https://u.expo.dev/444bda66-1ab4-4665-ba53-c2b76743a33b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
